# Wall Jewels — serve the new site first (the old site's index.php may still
# sit in the web root; this makes index.html win the directory index).
DirectoryIndex index.html index.php

# Pages always revalidate; assets cache for a week (filenames carry ?v= versions).
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|svg|woff2|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Wallpaper roll catalogues: cache for a week and display in the browser tab.
  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=604800"
    Header set Content-Disposition "inline"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/pdf .pdf
</IfModule>
